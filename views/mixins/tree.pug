mixin tree(category,index=1,id="")
    if(category)
        each item in category
            - const prefix=Array(index+1).join("--")
            option(value=item.id selected=(item.id===id)) #{prefix}#{item.title}
                if(item.childrent && item.childrent.length > 0)
                    +tree(item.childrent,index + 1,id)
