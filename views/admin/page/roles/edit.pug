extends ../../layout/default.pug 
include ../../../mixins/alert.pug 
block main 
        h1(class="mb-4") Chỉnh sửa nhóm quyền 
        form(
            action=`${prefixAdmin}/roles/edit/${roles.id}?_method=PATCH`
            method="POST"
        )
            div(class="form-group")
                label(for="title") Tiêu đề
                input(
                    type="text"
                    class="form-control"
                    id="title"
                    name="title"
                    required 
                    value=roles.title
                )
            div(class="form-group")
                label(for="desc") Mô tả
                input(
                    type="text"
                    class="form-control"
                    id="desc"
                    name="description"
                    value=roles.description
                )
            div(class="form-group")
                button(
                    type="submit"
                    class="btn btn-primary"
                ) Cập nhật