extends ../../layout/default.pug
include ../../../mixins/alert.pug 
block main
  +alert(5000)
  h1(class="mb-4") Phân quyền

  //- div #{records}

  div(class="text-right")
    button(
      type="submit"
      class="btn btn-primary mb-3"
      button-submit
    ) Cập nhật

  table(
    class="table table-hover table-sm"
    table-permission
  )
    thead
      tr
        th Tính năng
        each item in roles
            th(class="text-center") #{item.title}
    tbody
      tr(data-name="id" class="d-none")
        td(class="text-center") v
        each item in roles
            td(class="text-center")
                input(type="text" value=item.id)
      tr
        td(colspan="4")
          b Danh mục sản phẩm
      tr(data-name="products-category_view")
        td Xem
        each item in roles
            td(class="text-center")
                input(type="checkbox")
      tr(data-name="products-category_create")
        td Thêm mới
        each item in roles
            td(class="text-center")
                input(type="checkbox")
      tr(data-name="products-category_edit")
        td Chỉnh sửa
        each item in roles
            td(class="text-center")
                input(type="checkbox")
      tr(data-name="products-category_delete")
        td Xóaa
        each item in roles
            td(class="text-center")
                input(type="checkbox")
    form(
        id="form-change-permissions"
        method="POST"
        action=`${prefixAdmin}/roles/permission?_method=PATCH`
        )
        input(type="text" class="form-control d-none" name="permissions")
    script(src="/admin/js/permission.js")